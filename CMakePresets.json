{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 MinGW C++20",
      "description": "Native Windows build using the configured MinGW-w64 toolchain.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceParentDir}/${sourceDirName}.build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": {
          "type": "BOOL",
          "value": "ON"
        },
        "AGENT_RUNTIME_REPORT_DIR": "${sourceParentDir}/${sourceDirName}.build/${presetName}/Reports",
        "CMAKE_BUILD_TYPE": {
          "type": "STRING",
          "value": "Debug"
        },
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_EXTENSIONS": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_MAKE_PROGRAM": "mingw32-make",
        "CMAKE_CXX_STANDARD": {
          "type": "STRING",
          "value": "20"
        },
        "CMAKE_CXX_STANDARD_REQUIRED": {
          "type": "BOOL",
          "value": "ON"
        },
        "FETCHCONTENT_UPDATES_DISCONNECTED": {
          "type": "BOOL",
          "value": "ON"
        },
        "GCOV_EXECUTABLE": "gcov"
      }
    },
    {
      "name": "windows-agent-slice",
      "displayName": "Windows MinGW AgentRuntime Vertical Slice",
      "description": "Build and test the focused AgentRuntime and WorkflowController contracts.",
      "inherits": "windows-mingw",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/mingw32-make.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    },
    {
      "name": "windows-agent-slice",
      "configurePreset": "windows-agent-slice",
      "targets": [
        "AgentRuntimeVerticalSliceTests",
        "WorkflowControllerContractTests",
        "WorkflowController"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "PATH": "I:/cmake/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "windows-agent-slice",
      "inherits": "windows-mingw",
      "configurePreset": "windows-agent-slice",
      "filter": {
        "include": {
          "name": "^(AgentRuntime\\.VerticalSlice|WorkflowController\\.Contract)$"
        }
      }
    }
  ]
}
